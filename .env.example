# Local Docker Compose PostgreSQL. Replace all placeholder values in your .env.
POSTGRES_USER="foodrec"
POSTGRES_PASSWORD="replace-with-a-local-development-password"
POSTGRES_DB="foodrec"

# DATABASE_URL is the normal local app DB. Test URLs must stay separate and end in _test.
DATABASE_URL="postgresql://foodrec:replace-with-a-local-development-password@localhost:5432/foodrec?schema=public"
FOODREC_TEST_DATABASE_URL="postgresql://foodrec:replace-with-a-local-development-password@localhost:5432/foodrec_test?schema=public"
FOODREC_E2E_DATABASE_URL="postgresql://foodrec:replace-with-a-local-development-password@localhost:5432/foodrec_e2e_test?schema=public"

# Local application/authentication settings.
AUTH_SECRET="replace-with-a-random-local-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.local"
ADMIN_PASSWORD="replace-with-a-strong-local-admin-password"
FOODREC_STORAGE_DIR="."

# Python worker. Use the same secret in the Next.js and worker processes.
FOODREC_WORKER_SECRET="replace-with-a-random-local-secret-at-least-32-characters"
FOODREC_WORKER_API_URL="http://127.0.0.1:3000"

# Integration test files stay separate from normal app storage.
FOODREC_TEST_STORAGE_DIR="./storage-test"

# Fail-closed prototype guard. Leave disabled; npm run test:e2e injects temporary values.
FOODREC_TEST_RUN=""
FOODREC_TEST_AUTO_RECOMMENDATIONS="0"
FOODREC_E2E_RUN_ID=""
FOODREC_ORIGINAL_DATABASE_URL=""

# Optional test overrides; configure only when needed.
# FOODREC_PYTHON=
# FOODREC_CHROME_PATH=
# FOODREC_NEXT_DIST_DIR=
# FOODREC_E2E_OUTPUT_DIR=
# FOODREC_E2E_STORAGE_DIR=

# Optional Food.com E2E inputs. Requires rights-approved local data and a new _test DB.
# FOODREC_FOODCOM_E2E_DATABASE_URL=
# FOODREC_FOODCOM_PREPARED_DIR=
# FOODREC_RAW_RECIPES=
# FOODREC_FOODCOM_EXPORT_DIR=
