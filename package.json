{
  "name": "foodrec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components lib prisma tests scripts next.config.ts prisma.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs",
    "test": "tsx --test tests/auth.test.ts tests/database-isolation.test.ts tests/food-csv.test.ts tests/public-food-query.test.ts tests/recommendation-csv.test.ts scripts/test-database.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:foods": "tsx prisma/seed-foods.ts",
    "db:seed:demo-ratings": "tsx prisma/seed-demo-ratings.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.10",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "@eslint/js": "^9.39.5"
  }
