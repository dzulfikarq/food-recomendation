generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum FoodImportStatus {
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
}

enum RecommendationBatchStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  SUPERSEDED
}

enum RecommendationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ResearchStudyStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ResearchParticipantStatus {
  ACTIVE
  COMPLETED
  WITHDRAWAL_REQUESTED
  WITHDRAWN
}

enum ResearchWithdrawalStatus {
  PENDING
  PROCESSED
}

enum ResearchExportStatus {
  READY
  REVOCATION_REQUIRED
  REVOKED
}

enum ResearchRatingChangeType {
  CREATED
  UPDATED
}

/// Better Auth stores credential hashes in Account.password, not as plaintext on User.
model User {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(120)
  email            String    @unique @db.VarChar(254)
  emailVerified    Boolean   @default(false)
  image            String?   @db.Text
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  accounts         Account[]
  ratings          Rating[]
  foodImports      FoodImport[] @relation("FoodImportAdmin")
  datasetExports   DatasetExport[] @relation("DatasetExportAdmin")
  batches          RecommendationBatch[] @relation("RecommendationBatchAdmin")
  publishedBatches RecommendationBatch[] @relation("RecommendationBatchPublisher")
  recommendations Recommendation[] @relation("RecommendationUser")
  recommendationJobs RecommendationJob[] @relation("RecommendationJobCreator")
  researchStudies ResearchStudy[] @relation("ResearchStudyAdmin")
  researchParticipations ResearchParticipant[] @relation("ResearchParticipantUser")
  researchExports ResearchExport[] @relation("ResearchExportAdmin")
  processedResearchWithdrawals ResearchWithdrawal[] @relation("ResearchWithdrawalAdmin")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  userId                Int
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Food {
  id           Int      @id @default(autoincrement())
  foodCode     String   @unique @db.VarChar(64)
  name         String   @db.VarChar(180)
  description  String?  @db.Text
  category     String   @db.VarChar(100)
  taste        String   @db.VarChar(100)
  healthLevel  String?  @db.VarChar(80)
  origin       String   @db.VarChar(100)
  proteinType  String?  @db.VarChar(100)
  priceCategory String? @db.VarChar(80)
  mealTime     String?  @db.VarChar(80)
  dietCategory String?  @db.VarChar(100)
  texture      String?  @db.VarChar(100)
  imageUrl     String?  @db.Text
  isActive     Boolean  @default(true)
  firstUsedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ratings      Rating[]
  recommendations Recommendation[]
  researchRatings ResearchRating[]
  researchRatingChanges ResearchRatingChange[]

  @@index([isActive, category])
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  foodId    Int
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([userId, foodId])
  @@index([userId])
  @@index([foodId])
}

/// ponytail: singleton revision row serializes rating writes; shard by dataset if throughput requires it.
model RatingDatasetState {
  id                       Int       @id @default(1)
  currentRevision          BigInt    @default(0)
  processedRevision        BigInt    @default(0)
  lastRatingChangedAt      DateTime?
}

model RecommendationEngineConfig {
  id                             Int       @id @default(1)
  autoProcessingEnabled          Boolean   @default(false)
  automaticPublicationEnabled    Boolean   @default(false)
  kNeighbors                     Int       @default(3)
  topN                           Int       @default(5)
  scheduleIntervalMinutes        Int       @default(30)
  engineVersion                  String    @default("python-ubcf-v1") @db.VarChar(40)
  lastSuccessfulProcessingAt     DateTime?
  validationStatus               String    @default("PENDING_VALIDATION") @db.VarChar(40)
  schedulerLastCheckedAt         DateTime?
  nextScheduleAt                 DateTime  @default(now())
  lastSchedulerReason            String?   @db.VarChar(60)
}

model RecommendationWorker {
  workerId      String   @id @db.VarChar(120)
  engineVersion String   @db.VarChar(40)
  lastSeenAt    DateTime @default(now())

  @@index([lastSeenAt])
}

model FoodImport {
  id           Int             @id @default(autoincrement())
  adminId      Int
  filename     String          @db.VarChar(255)
  fileChecksum String          @db.VarChar(64)
  totalRows    Int
  insertedRows Int
  status       FoodImportStatus
  stagingKey   String?         @db.VarChar(64)
  createdAt    DateTime        @default(now())
  admin        User            @relation("FoodImportAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([fileChecksum])
}

model DatasetExport {
  id           Int      @id @default(autoincrement())
  adminId      Int
  filename     String   @db.VarChar(255)
  fileChecksum String   @db.VarChar(64)
  rowCount     Int
  filePath     String   @db.Text
  ratingRevision BigInt @default(0)
  createdAt    DateTime @default(now())
  admin        User     @relation("DatasetExportAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  batches      RecommendationBatch[]
  recommendationJobs RecommendationJob[]

  @@index([adminId, createdAt])
  @@index([fileChecksum])
}

model RecommendationBatch {
  id               Int                       @id @default(autoincrement())
  datasetExportId Int
  adminId         Int
  publishedById   Int?
  status          RecommendationBatchStatus @default(DRAFT)
  kNeighbors      Int
  topN            Int
  similarity      String                    @default("COSINE") @db.VarChar(40)
  fileChecksum    String                    @db.VarChar(64)
  filename        String?                   @db.VarChar(255)
  filePath        String?                   @db.Text
  validationReport Json?
  createdAt       DateTime                  @default(now())
  publishedAt     DateTime?
  datasetExport   DatasetExport             @relation(fields: [datasetExportId], references: [id], onDelete: Restrict)
  admin           User                      @relation("RecommendationBatchAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  publishedBy     User?                     @relation("RecommendationBatchPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  recommendations Recommendation[]

  @@index([datasetExportId])
  @@index([adminId, createdAt])
  @@index([publishedById])
  @@index([status, publishedAt])
}

model RecommendationJob {
  id                String                   @id @default(uuid()) @db.Uuid
  datasetExportId   Int
  createdByAdminId  Int
  trigger           String                   @default("MANUAL_ADMIN") @db.VarChar(40)
  idempotencyKey    String                   @unique @db.VarChar(100)
  automaticDedupeKey String?                 @unique @db.VarChar(64)
  engineVersion     String                   @db.VarChar(40)
  parameters        Json                     @db.JsonB
  status            RecommendationJobStatus  @default(PENDING)
  attemptCount      Int                      @default(0)
  maxAttempts       Int                      @default(3)
  timeoutSeconds    Int                      @default(900)
  nextAttemptAt     DateTime                 @default(now())
  leaseToken        String?                  @db.Uuid
  leaseExpiresAt    DateTime?
  timeoutAt         DateTime?
  workerId          String?                  @db.VarChar(120)
  heartbeatAt       DateTime?
  createdAt         DateTime                 @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  errorSummary      String?                  @db.VarChar(255)
  datasetExport     DatasetExport            @relation(fields: [datasetExportId], references: [id], onDelete: Restrict)
  createdByAdmin    User                     @relation("RecommendationJobCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  artifact          RecommendationJobArtifact?

  @@index([status, nextAttemptAt, createdAt])
  @@index([datasetExportId, createdAt])
  @@index([status, leaseExpiresAt])
}

model RecommendationJobArtifact {
  id                 String             @id @default(uuid()) @db.Uuid
  jobId              String             @unique @db.Uuid
  verificationStatus String             @default("UNVERIFIED") @db.VarChar(20)
  checksum           String             @db.VarChar(64)
  rowCount           Int
  sourceRatingRevision BigInt           @default(0)
  currentRatingRevision BigInt          @default(0)
  isStale             Boolean           @default(false)
  payload            Json               @db.JsonB
  createdAt          DateTime           @default(now())
  job                RecommendationJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
}

model Recommendation {
  id        Int      @id @default(autoincrement())
  batchId   Int
  userId    Int
  foodId    Int
  rank      Int
  createdAt DateTime @default(now())
  batch     RecommendationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  user      User     @relation("RecommendationUser", fields: [userId], references: [id], onDelete: Restrict)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([batchId, userId, foodId])
  @@unique([batchId, userId, rank])
  @@index([userId, batchId])
  @@index([foodId])
}

model ResearchStudy {
  id                     Int                 @id @default(autoincrement())
  title                  String              @db.VarChar(180)
  description            String              @db.Text
  purpose                String              @db.Text
  dataCollected          String              @db.Text
  dataUse                String              @db.Text
  withdrawalInstructions String              @db.Text
  consentVersion         String              @db.VarChar(40)
  consentDocument        String              @db.Text
  contactName            String              @db.VarChar(120)
  contactEmail           String              @db.VarChar(254)
  startsAt               DateTime
  closesAt               DateTime
  status                 ResearchStudyStatus @default(DRAFT)
  createdByAdminId       Int
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  createdByAdmin         User                @relation("ResearchStudyAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  participants           ResearchParticipant[]
  exports                ResearchExport[]

  @@index([status, startsAt, closesAt])
  @@index([createdByAdminId, createdAt])
}

/// Numeric ID is a study-scoped pseudonym in exports; userId is kept separately for account ownership.
model ResearchParticipant {
  id                    Int                       @id @default(autoincrement())
  studyId               Int
  userId                Int
  status                ResearchParticipantStatus @default(ACTIVE)
  completedAt           DateTime?
  withdrawalRequestedAt DateTime?
  withdrawnAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  study                 ResearchStudy             @relation(fields: [studyId], references: [id], onDelete: Restrict)
  user                  User                      @relation("ResearchParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  consents              ResearchConsent[]
  ratings               ResearchRating[]
  ratingChanges         ResearchRatingChange[]
  withdrawal            ResearchWithdrawal?
  exportMemberships     ResearchExportParticipant[]

  @@unique([studyId, userId])
  @@index([studyId, status])
  @@index([userId, createdAt])
}

model ResearchConsent {
  id            Int                 @id @default(autoincrement())
  participantId Int
  version       String              @db.VarChar(40)
  documentText  String              @db.Text
  acceptedAt    DateTime            @default(now())
  revokedAt     DateTime?
  participant   ResearchParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([participantId, version])
  @@index([participantId, version, revokedAt])
}

model ResearchRating {
  id            Int                 @id @default(autoincrement())
  participantId Int
  foodId        Int
  rating        Int
  triedAt       DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  participant   ResearchParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  food          Food                @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([participantId, foodId])
  @@index([foodId, rating])
  @@index([participantId, updatedAt])
}

model ResearchRatingChange {
  id             Int                       @id @default(autoincrement())
  participantId  Int
  foodId         Int
  changeType     ResearchRatingChangeType
  oldRating      Int?
  newRating      Int
  idempotencyKey String                    @db.VarChar(36)
  createdAt      DateTime                  @default(now())
  participant    ResearchParticipant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  food           Food                      @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([participantId, idempotencyKey])
  @@index([participantId, createdAt])
  @@index([foodId, createdAt])
}

model ResearchWithdrawal {
  id                 Int                     @id @default(autoincrement())
  participantId      Int                     @unique
  status             ResearchWithdrawalStatus @default(PENDING)
  requestedAt        DateTime                @default(now())
  processedAt        DateTime?
  processedByAdminId Int?
  participant        ResearchParticipant     @relation(fields: [participantId], references: [id], onDelete: Restrict)
  processedByAdmin   User?                   @relation("ResearchWithdrawalAdmin", fields: [processedByAdminId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
}

model ResearchExport {
  id                   Int                 @id @default(autoincrement())
  studyId              Int
  version              Int
  createdByAdminId     Int
  filename             String              @db.VarChar(255)
  filePath             String              @db.VarChar(64)
  fileChecksum         String              @db.VarChar(64)
  participantCount     Int
  ratingCount          Int
  foodCount            Int
  consentVersion       String              @db.VarChar(40)
  manifest             Json                @db.JsonB
  status               ResearchExportStatus @default(READY)
  withdrawalAffectedAt DateTime?
  revokedAt            DateTime?
  createdAt            DateTime            @default(now())
  study                ResearchStudy       @relation(fields: [studyId], references: [id], onDelete: Restrict)
  createdByAdmin       User                @relation("ResearchExportAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  participantMemberships ResearchExportParticipant[]

  @@unique([studyId, version])
  @@index([createdByAdminId, createdAt])
  @@index([studyId, createdAt])
  @@index([status, withdrawalAffectedAt])
}

model ResearchExportParticipant {
  exportId      Int
  participantId Int
  export        ResearchExport      @relation(fields: [exportId], references: [id], onDelete: Restrict)
  participant   ResearchParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@id([exportId, participantId])
  @@index([participantId, exportId])
}
